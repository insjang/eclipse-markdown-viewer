<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.editors">
      <editor id="io.github.insjang.mdviewer.editor" name="Markdown Viewer"
            class="io.github.insjang.mdviewer.MarkdownEditor"
            contributorClass="io.github.insjang.mdviewer.Contributor"
            icon="icons/markdown.png"
            extensions="md,markdown,mdown,mkd" default="true"/>
   </extension>
   <!-- typing aids for the Source, attached to the Generic Editor for Markdown files -->
   <extension point="org.eclipse.ui.genericeditor.autoEditStrategies">
      <autoEditStrategy class="io.github.insjang.mdviewer.editing.ListAutoEdit"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page id="io.github.insjang.mdviewer.prefs" name="Markdown Viewer"
            category="org.eclipse.ui.preferencePages.Editors"
            class="io.github.insjang.mdviewer.MarkdownPreferencePage"/>
   </extension>
   <!-- pairs the language configuration lacks: the backtick of inline code, the closing line of a code fence -->
   <extension point="org.eclipse.ui.genericeditor.autoEditStrategies">
      <autoEditStrategy class="io.github.insjang.mdviewer.editing.PairAutoEdit"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
   <extension point="org.eclipse.ui.genericeditor.autoEditStrategies">
      <autoEditStrategy class="io.github.insjang.mdviewer.editing.TableAutoEdit"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
   <extension point="org.eclipse.ui.startup">
      <startup class="io.github.insjang.mdviewer.TabClose"/>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="io.github.insjang.mdviewer.PrefInit"/>
   </extension>
   <extension point="org.eclipse.core.resources.markers" id="link" name="Markdown link">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
   </extension>
</plugin>

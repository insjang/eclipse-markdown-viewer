<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.editors">
      <editor id="io.github.insjang.mdviewer.editor" name="Markdown Viewer"
            class="io.github.insjang.mdviewer.MarkdownEditor"
            contributorClass="io.github.insjang.mdviewer.Contributor"
            icon="icons/markdown.png"
            extensions="md,markdown,mdown,mkd" default="true"/>
   </extension>
   <!-- typing aids for the Source, attached to the Generic Editor for Markdown files -->
   <extension point="org.eclipse.ui.genericeditor.autoEditStrategies">
      <autoEditStrategy class="io.github.insjang.mdviewer.editing.ListAutoEdit"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page id="io.github.insjang.mdviewer.prefs" name="Markdown Viewer"
            category="org.eclipse.ui.preferencePages.Editors"
            class="io.github.insjang.mdviewer.MarkdownPreferencePage"/>
   </extension>
   <!-- pairs the language configuration lacks: the backtick of inline code, the closing line of a code fence -->
   <extension point="org.eclipse.ui.genericeditor.autoEditStrategies">
      <autoEditStrategy class="io.github.insjang.mdviewer.editing.PairAutoEdit"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
   <extension point="org.eclipse.ui.genericeditor.autoEditStrategies">
      <autoEditStrategy class="io.github.insjang.mdviewer.editing.TableAutoEdit"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
   <!-- formatting in the Source: Ctrl+B, Ctrl+I, Ctrl+K, and a web address pasted over selected text makes it a link -->
   <extension point="org.eclipse.ui.contexts">
      <context id="io.github.insjang.mdviewer.markdownEditing" name="Editing Markdown"
            parentId="org.eclipse.ui.textEditorScope"/>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <category id="io.github.insjang.mdviewer.category" name="Markdown"/>
      <command id="io.github.insjang.mdviewer.bold" name="Bold" categoryId="io.github.insjang.mdviewer.category"/>
      <command id="io.github.insjang.mdviewer.italic" name="Italic" categoryId="io.github.insjang.mdviewer.category"/>
      <command id="io.github.insjang.mdviewer.link" name="Link" categoryId="io.github.insjang.mdviewer.category"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="io.github.insjang.mdviewer.bold" class="io.github.insjang.mdviewer.editing.FormatHandler">
         <activeWhen><with variable="activeEditorId"><equals value="io.github.insjang.mdviewer.editor"/></with></activeWhen>
      </handler>
      <handler commandId="io.github.insjang.mdviewer.italic" class="io.github.insjang.mdviewer.editing.FormatHandler">
         <activeWhen><with variable="activeEditorId"><equals value="io.github.insjang.mdviewer.editor"/></with></activeWhen>
      </handler>
      <handler commandId="io.github.insjang.mdviewer.link" class="io.github.insjang.mdviewer.editing.FormatHandler">
         <activeWhen><with variable="activeEditorId"><equals value="io.github.insjang.mdviewer.editor"/></with></activeWhen>
      </handler>
   </extension>
   <extension point="org.eclipse.ui.bindings">
      <key commandId="io.github.insjang.mdviewer.bold" sequence="M1+B"
            contextId="io.github.insjang.mdviewer.markdownEditing" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="io.github.insjang.mdviewer.italic" sequence="M1+I"
            contextId="io.github.insjang.mdviewer.markdownEditing" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="io.github.insjang.mdviewer.link" sequence="M1+K"
            contextId="io.github.insjang.mdviewer.markdownEditing" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>
   <extension point="org.eclipse.ui.genericeditor.autoEditStrategies">
      <autoEditStrategy class="io.github.insjang.mdviewer.editing.LinkPasteAutoEdit"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
   <!-- bookmarks in text editors (optional, off by default). Their keys sit in a context active only while the feature is on
        and a text editor is: two levels below the text editor scope, so F2 and Shift+F2 win over Show Tooltip Description and
        the Java editor's Open External Javadoc then, and are theirs again when the feature is off. Go to Quick Bookmark is
        in the window context too (from any view), and in this one as well to win over other bookmark plugins in a text editor -->
   <extension point="org.eclipse.ui.contexts">
      <context id="io.github.insjang.mdviewer.bookmarksBase" name="Bookmarks (base)" parentId="org.eclipse.ui.textEditorScope"/>
      <context id="io.github.insjang.mdviewer.bookmarks" name="Bookmarks in Text Editors" parentId="io.github.insjang.mdviewer.bookmarksBase"/>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <command id="io.github.insjang.mdviewer.bookmark.toggle" name="Toggle Bookmark" categoryId="org.eclipse.ui.category.edit"></command>
      <command id="io.github.insjang.mdviewer.bookmark.next" name="Next Bookmark" categoryId="org.eclipse.ui.category.edit"></command>
      <command id="io.github.insjang.mdviewer.bookmark.previous" name="Previous Bookmark" categoryId="org.eclipse.ui.category.edit"></command>
      <command id="io.github.insjang.mdviewer.bookmark.set" name="Set Quick Bookmark" categoryId="org.eclipse.ui.category.edit"><commandParameter id="number" name="Number" optional="false"/></command>
      <command id="io.github.insjang.mdviewer.bookmark.goto" name="Go to Quick Bookmark" categoryId="org.eclipse.ui.category.edit"><commandParameter id="number" name="Number" optional="false"/></command>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="io.github.insjang.mdviewer.bookmark.toggle" class="io.github.insjang.mdviewer.Bookmarks"/>
      <handler commandId="io.github.insjang.mdviewer.bookmark.next" class="io.github.insjang.mdviewer.Bookmarks"/>
      <handler commandId="io.github.insjang.mdviewer.bookmark.previous" class="io.github.insjang.mdviewer.Bookmarks"/>
      <handler commandId="io.github.insjang.mdviewer.bookmark.set" class="io.github.insjang.mdviewer.Bookmarks"/>
      <handler commandId="io.github.insjang.mdviewer.bookmark.goto" class="io.github.insjang.mdviewer.Bookmarks"/>
   </extension>
   <extension point="org.eclipse.ui.bindings">
      <key commandId="io.github.insjang.mdviewer.bookmark.toggle" sequence="M3+F2" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="io.github.insjang.mdviewer.bookmark.next" sequence="F2" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="io.github.insjang.mdviewer.bookmark.previous" sequence="M2+F2" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+0" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="0"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+0" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="0"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+0" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="0"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+1" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="1"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+1" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="1"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+1" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="1"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+2" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="2"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+2" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="2"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+2" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="2"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+3" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="3"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+3" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="3"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+3" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="3"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+4" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="4"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+4" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="4"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+4" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="4"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+5" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="5"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+5" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="5"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+5" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="5"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+6" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="6"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+6" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="6"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+6" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="6"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+7" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="7"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+7" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="7"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+7" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="7"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+8" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="8"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+8" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="8"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+8" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="8"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.set" sequence="M3+9" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="9"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+9" contextId="org.eclipse.ui.contexts.window" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="9"/></key>
      <key commandId="io.github.insjang.mdviewer.bookmark.goto" sequence="M2+M3+9" contextId="io.github.insjang.mdviewer.bookmarks" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"><parameter id="number" value="9"/></key>
   </extension>
   <!-- folding of Markdown in the Source: heading sections, code blocks, tables, quotes, lists -->
   <extension point="org.eclipse.ui.genericeditor.foldingReconcilers">
      <foldingReconcilingStrategy class="io.github.insjang.mdviewer.FoldingStrategy"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
   <!-- the button "Side by side" (main toolbar while a Markdown editor is active, and in the Preview): Source and Preview next to each other -->
   <extension point="org.eclipse.ui.commands">
      <command id="io.github.insjang.mdviewer.splitSide" name="Show Source and Preview side by side"
            description="Source and Preview of this document next to each other, kept in step by line"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="io.github.insjang.mdviewer.splitSide" class="io.github.insjang.mdviewer.SplitSideHandler">
         <activeWhen><with variable="activeEditorId"><equals value="io.github.insjang.mdviewer.editor"/></with></activeWhen>
      </handler>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar">
         <toolbar id="io.github.insjang.mdviewer.toolbar">
            <command commandId="io.github.insjang.mdviewer.splitSide" icon="icons/split.png" tooltip="Source and Preview side by side"
                  style="push">
               <visibleWhen checkEnabled="false"><with variable="activeEditorId"><equals value="io.github.insjang.mdviewer.editor"/></with></visibleWhen>
            </command>
         </toolbar>
      </menuContribution>
   </extension>
   <extension point="org.eclipse.ui.startup">
      <startup class="io.github.insjang.mdviewer.TabClose"/>
      <startup class="io.github.insjang.mdviewer.Bookmarks"/>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="io.github.insjang.mdviewer.PrefInit"/>
   </extension>
   <extension point="org.eclipse.core.resources.markers" id="link" name="Markdown link">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
   </extension>
   <!-- links in the Source: Ctrl+click, and content assist for files, anchors, reference labels and fence languages -->
   <extension point="org.eclipse.ui.workbench.texteditor.hyperlinkDetectors">
      <hyperlinkDetector id="io.github.insjang.mdviewer.linkDetector" name="Markdown links"
            class="io.github.insjang.mdviewer.editing.LinkDetector"
            targetId="org.eclipse.ui.genericeditor.GenericEditor"/>
   </extension>
   <extension point="org.eclipse.ui.genericeditor.contentAssistProcessors">
      <contentAssistProcessor class="io.github.insjang.mdviewer.editing.LinkAssist"
            contentType="org.eclipse.tm4e.language_pack.markdown"/>
   </extension>
</plugin>
